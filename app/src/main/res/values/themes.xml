<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.NavoPlayerMusic" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/navo_window_background</item>
    </style>

    <style name="Theme.NavoPlayerMusic" parent="Base.Theme.NavoPlayerMusic" />

    <style name="Theme.NavoPlayerMusic.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/navo_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/navo_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">@integer/navo_splash_icon_duration_millis</item>
        <item name="postSplashScreenTheme">@style/Theme.NavoPlayerMusic</item>
        <item name="android:windowLightStatusBar">@bool/navo_light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/navo_light_system_bars</item>
        <item name="android:windowSplashScreenBehavior" tools:targetApi="33">icon_preferred</item>
    </style>
</resources>
